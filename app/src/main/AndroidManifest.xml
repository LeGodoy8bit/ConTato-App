<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissão para utilizar a vibração do dispositivo -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Permissões Bluetooth para Android 11 ou inferior -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Permissões de localização utilizadas por versões antigas do Android -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Permissões de rede -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permissão para descoberta de dispositivos Wi-Fi próximos -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />

    <!-- Permissões Bluetooth para Android 12 ou superior -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ConTatoApp">

        <!-- Android 16 em tablets ignora a trava de orientação; o app foi feito só para a vertical. -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <!-- Tela inicial do aplicativo: splash completa na 1ª abertura, curta nas seguintes -->
        <activity
            android:name=".presentation.onboarding.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Atalhos: botões de volume (acessibilidade) e "tocar e segurar o ícone" abrem o modo Surdocego -->
        <activity
            android:name=".presentation.DeafblindShortcutActivity"
            android:exported="true"
            android:label="@string/a11y_shortcut_label"
            android:icon="@mipmap/ic_launcher"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.ACCESSIBILITY_SHORTCUT_TARGET" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityshortcut.target"
                android:resource="@xml/accessibility_shortcut_target" />
        </activity>

        <!-- Tela de seleção do modo de comunicação -->
        <activity
            android:name=".presentation.ModeSelectionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Tela de depuração da conexão entre dispositivos -->
        <activity
            android:name=".presentation.debug.NearbyDebugActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />

        <!-- Tela de comunicação da pessoa com surdocegueira -->
        <activity
            android:name=".presentation.DeafblindActivity"
            android:exported="false"
            android:screenOrientation="sensorPortrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            />


        <!-- Tela do interlocutor -->
        <activity
            android:name=".presentation.CommunicatorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"

            />

    </application>

</manifest>
